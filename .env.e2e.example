# Local Playwright E2E harness — copy to `.env.e2e` (gitignored) and fill in.
#
# These should point to a throwaway/staging Supabase project, never prod.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-from-supabase-settings
SUPABASE_PUBLISHABLE_KEY=publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

# Where the harness launches Playwright against. Leave unset to let
# playwright.config.ts boot `bun run dev` automatically on :5173.
# E2E_BASE_URL=http://localhost:5173

# SMTP fixture (Mailpit). Start with: docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_HTTP_PORT=8025

# OAuth fixture — dummy values; the spec mocks the provider response.
E2E_FAKE_OAUTH_CLIENT_ID=test-google-client-id
E2E_FAKE_OAUTH_CLIENT_SECRET=test-google-secret
