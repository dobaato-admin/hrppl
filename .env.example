# =============================================================================
# .env.example — variable NAMES only. Never put a real value in this file.
# =============================================================================
#
# This is the one env file that IS committed (.gitignore whitelists it).
# Copy to `.env` and fill in locally; `.env` and every other `.env.*` are
# ignored.
#
# Anything prefixed VITE_ is COMPILED INTO THE BROWSER BUNDLE at build time.
# Never give a VITE_ variable a secret, and remember that changing one in a
# hosting dashboard does nothing until you rebuild.

# --- Supabase: server-side (not bundled into the client) ---------------------
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS entirely. Server-only — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# --- Supabase: client-side (compiled into the bundle) ------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Management API (DDL, typegen, scripts/configure-auth.mjs) ------
# A personal access token, not a project key. Account-wide: grants full control
# of every project on the account. The most powerful credential in this file.
SUPABASE_ACCESS_TOKEN=

# =============================================================================
# Email — two halves, two systems. Both are needed.
# =============================================================================
#
#   Auth email     signup confirmation, password reset, magic link,
#                  email-change. Sent by GoTrue INSIDE Supabase. Nothing in
#                  src/ can intercept it. Configured on the Supabase project
#                  from the SMTP_* values below, via:
#                     node scripts/configure-auth.mjs --env <prod|dev> --smtp
#
#   App email      invitations, reminders, payslips, approvals — all 28
#                  templates. Sent by this codebase. Needs RESEND_API_KEY and
#                  EMAIL_FROM in the hosting environment.
#
# Setting only one leaves half the mail unsent, and the half that fails is the
# half nobody tests: password reset.

# --- App email ---------------------------------------------------------------
RESEND_API_KEY=
# Must be a domain verified with the provider, or every send is a hard 403.
# Format: `Display Name <address@domain>`
EMAIL_FROM=

# --- Auth email: SMTP, written to the Supabase project by configure-auth.mjs --
# For Resend: host smtp.resend.com, port 465, username is the literal word
# `resend` for every account, password is the API key. Putting the key in the
# username authenticates as nobody and returns a generic 535.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Falls back to RESEND_API_KEY when unset — with Resend they are the same
# secret. Set it separately only if you want to revoke them independently.
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
# Any SMTP_* name may be prefixed with the --env value to override it for one
# project only: PROD_SMTP_SENDER_NAME, DEV_SMTP_ADMIN_EMAIL, and so on. The
# prefixed name wins. Use it for the identity fields — without it a single
# SMTP_SENDER_NAME in a development .env stamps production invitations with
# whatever local testing left there, and only the recipient ever sees it.
PROD_SMTP_SENDER_NAME=
DEV_SMTP_SENDER_NAME=
# Messages per hour. Supabase's shared sender caps at 2; a real sender does not
# need that, but a cap still stops a loop emptying the quota. Default 30.
SMTP_RATE_LIMIT=

# =============================================================================
# Deployment
# =============================================================================
# Public URL of this deployment. Invitation and reminder emails build their
# links from it; unset, the code falls back to a literal that is not your site
# and every link is dead with nothing reporting it.
PUBLIC_APP_URL=
APP_URL=
SITE_URL=
PUBLIC_SITE_URL=

# Cron auth. isAuthorizedCronRequest FAILS CLOSED without CRON_SECRET, so the
# scheduled jobs 401 silently rather than erroring.
CRON_SECRET=
AUDIT_RETENTION_SECRET=

# --- Google Maps (geofence). Domain-restrict this key. ------------------------
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# --- Local development only ---------------------------------------------------
# Disables the mandatory MFA gate. Only read when import.meta.env.DEV is true,
# so it cannot reach a production build. Never set it in a hosting environment.
VITE_DEV_BYPASS_MFA=
